# Copy to .env and adjust the values
WEB_BIND=0.0.0.0
WEB_PORT=8180
IMAGE_TAG=latest
UPSTREAM_REPO=https://github.com/Paul6552/sweet3D.git
UPSTREAM_BRANCH=main
# Where deploy.sh keeps the upstream clone (outside the project, so src/ has no .git)
# CACHE_DIR=/home/youruser/.cache/swethome3d-upstream

# Login / sync server
SESSION_TTL_DAYS=30
ADMIN_USER=admin
# Gol = parola aleatoare la primul start (vezi ./deploy.sh logs)
ADMIN_PASSWORD=
# 1 daca aplicatia este servita prin HTTPS
COOKIE_SECURE=0
# Limita pentru fisierele importate (MB)
MAX_CONTENT_MB=1024
